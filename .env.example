# SubDeck 部署配置模板：复制为 .env 并按需修改
# cp .env.example .env

# 访问密码（留空 = 不启用登录）。若会暴露到公网（如通过隧道访问），强烈建议设置！
AUTH_PASSWORD=

# 容器时区（影响"今天"的判定与账单日滚动）
TZ=Asia/Shanghai

# 宿主机端口：浏览器访问 http://NAS_IP:8300
SUBDECK_PORT=8300

# 数据目录（SQLite 数据库 + 上传的 logo 都在这里；备份 = 备份这个目录）
# Docker Compose 部署时默认挂载 ./data，一般无需修改
SUBDECK_DATA=./data

# 可选：数据目录属主对齐（与 NAS 其他容器共享 data 目录时使用，两个都填才生效）
# 不填则由入口脚本自动把数据目录属主修正为容器内运行用户
# PUID=1000
# PGID=1000
